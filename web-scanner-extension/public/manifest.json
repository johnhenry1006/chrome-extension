{
    "manifest_version": 3,
    "name": "Web Data Scanner",
    "version": "0.7.2",
    "description": "Generic web data scanner with SQLite WASM and OPFS.",
    "permissions": ["activeTab", "scripting", "storage", "tabs", "offscreen"],
    "host_permissions": ["<all_urls>"],
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; img-src 'self' data: https:;"
    },
    "background": {
        "service_worker": "src/background/service-worker.js",
        "type": "module"
    },
    "action": {
        "default_title": "Web Data Scanner",
        "default_popup": "src/popup/popup.html"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["src/content/content.js"],
            "run_at": "document_idle"
        }
    ],
    "icons": {
        "16": "icon16.png",
        "32": "icon32.png",
        "48": "icon48.png",
        "128": "icon128.png"
    }
}
